{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "900Notes Mobile",
  "version": "1.5.0",
  "identifier": "com.ninelabs.notes.mobile",
  "build": {
    "beforeDevCommand": "npm run dev:mobile",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:mobile",
    "frontendDist": "../src/mobile/dist-mobile"
  },
  "app": {
    "windows": [
      {
        "title": "900Notes Mobile",
        "width": 390,
        "height": 844,
        "minWidth": 320,
        "minHeight": 568,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  },
  "plugins": {}
}
