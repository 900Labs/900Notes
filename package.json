{
  "name": "900notes",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:capabilities": "node scripts/check-tauri-capabilities.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "dev:mobile": "vite --config vite.mobile.config.ts --port 1421",
    "build:mobile": "vite build --config vite.mobile.config.ts --outDir dist-mobile",
    "tauri:mobile:dev": "cargo tauri dev --config src-tauri/tauri.mobile.conf.json",
    "tauri:mobile:build": "cargo tauri build --config src-tauri/tauri.mobile.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "katex": "^0.17.0",
    "mermaid": "^11.16.1",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-history": "^1.4.1",
    "prosemirror-inputrules": "^1.4.0",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.23.0",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.34.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.2",
    "@types/prosemirror-keymap": "^1.2.0",
    "@types/prosemirror-model": "^1.17.0",
    "@types/prosemirror-state": "^1.4.0",
    "@types/prosemirror-transform": "^1.5.0",
    "@types/prosemirror-view": "^1.24.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  }
}
